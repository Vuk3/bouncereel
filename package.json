{
  "name": "bouncereel",
  "private": true,
  "version": "1.0.9",
  "type": "module",
  "scripts": {
    "predev": "CI=true wrangler d1 migrations apply bouncereel --local",
    "dev": "vite",
    "check": "tsc && tsc -p worker",
    "build": "npm run check && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && CI=true wrangler d1 migrations apply bouncereel --remote && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply bouncereel --local",
    "db:migrate:remote": "wrangler d1 migrations apply bouncereel --remote",
    "tune": "node scripts/tune.ts",
    "admin": "node scripts/admin.mjs",
    "release": "node release.js"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "kokoro-js": "^1.2.1"
  }
}
